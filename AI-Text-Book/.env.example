# ============================================
# RAG Chatbot Configuration (Feature 002)
# ============================================

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=textbook_chunks

# Database (Neon Serverless Postgres)
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# AI Services
OPENAI_API_KEY=sk-your_openai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here



# RAG Configuration
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=0.1
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TEMPERATURE=0.3
RAG_MAX_TOKENS=8000

# API Configuration
CHATBOT_API_URL=http://localhost:8000
CHATBOT_API_TIMEOUT=10000
CHATBOT_RATE_LIMIT_ANONYMOUS=10
CHATBOT_RATE_LIMIT_AUTHENTICATED=100
CHATBOT_RATE_LIMIT_PREMIUM=1000
