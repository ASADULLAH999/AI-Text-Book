{
  "version": 2,
  "name": "ai-textbook-chatbot-api",
  "builds": [
    {
      "src": "src/main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/v1/health",
      "dest": "src/main.py",
      "methods": ["GET"]
    },
    {
      "src": "/api/v1/chat",
      "dest": "src/main.py",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/v1/chunks",
      "dest": "src/main.py",
      "methods": ["GET"]
    },
    {
      "src": "/api/v1/(.*)",
      "dest": "src/main.py"
    }
  ],
  "env": {
    "QDRANT_URL": "@qdrant_url",
    "QDRANT_API_KEY": "@qdrant_api_key",
    "QDRANT_COLLECTION_NAME": "@qdrant_collection_name",
    "NEON_DATABASE_URL": "@neon_database_url",
    "OPENAI_API_KEY": "@openai_api_key",
    "COHERE_API_KEY": "@cohere_api_key",
    "UPSTASH_REDIS_URL": "@upstash_redis_url",
    "UPSTASH_REDIS_TOKEN": "@upstash_redis_token",
    "SENTRY_DSN": "@sentry_dsn",
    "SENTRY_ENVIRONMENT": "production",
    "RAG_CHUNK_SIZE": "1024",
    "RAG_CHUNK_OVERLAP": "0.1",
    "RAG_TOP_K": "10",
    "RAG_SIMILARITY_THRESHOLD": "0.7",
    "RAG_TEMPERATURE": "0.3",
    "RAG_MAX_TOKENS": "8000"
  },
  "functions": {
    "src/main.py": {
      "memory": 512,
      "maxDuration": 30,
      "runtime": "python3.11",
      "includeFiles": "src/**"
    }
  },
  "regions": ["iad1"],
  "framework": null
}
