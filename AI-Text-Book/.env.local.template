# Environment Configuration Template
# Copy this file to .env.local and fill in your NEW values after rotating keys

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_new_supabase_anon_key_here

# API Configuration
REACT_APP_API_URL=http://localhost:3000
REACT_APP_API_TIMEOUT=30000

# Features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_CHATBOT=false
REACT_APP_ENABLE_SEARCH=true

# Performance
REACT_APP_QUIZ_TIMEOUT=600000
REACT_APP_SESSION_TIMEOUT=3600000

# Build
NODE_ENV=development
CI=false

# ============================================
# RAG Chatbot Configuration (Feature 002)
# ============================================

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_new_qdrant_api_key_here
QDRANT_COLLECTION_NAME=textbook_chunks

# Database (Neon Serverless Postgres)
NEON_DATABASE_URL=postgresql://user:NEW_PASSWORD@host.neon.tech/dbname?sslmode=require

# AI Services
OPENAI_API_KEY=sk-your_new_openai_api_key_here
COHERE_API_KEY=your_new_cohere_api_key_here

# RAG Configuration
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=0.1
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TEMPERATURE=0.3
RAG_MAX_TOKENS=8000

# API Configuration
CHATBOT_API_URL=http://localhost:8000
CHATBOT_API_TIMEOUT=10000
CHATBOT_RATE_LIMIT_ANONYMOUS=10
CHATBOT_RATE_LIMIT_AUTHENTICATED=100
CHATBOT_RATE_LIMIT_PREMIUM=1000
