# ==============================================
# RAG-Powered Textbook Chatbot - Environment Configuration
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ---------------------------------------------
# OpenAI API Configuration
# ---------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# ---------------------------------------------
# Qdrant Vector Database Configuration
# ---------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=textbook_chunks
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE=Cosine
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100

# ---------------------------------------------
# Neon Serverless Postgres Configuration
# ---------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require
POSTGRES_HOST=ep-xxxxx.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=ai_textbook
POSTGRES_USER=your-username
POSTGRES_PASSWORD=your-password
POSTGRES_SSL_MODE=require
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ---------------------------------------------
# Application Configuration
# ---------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# ---------------------------------------------
# CORS Configuration
# ---------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID

# ---------------------------------------------
# Rate Limiting Configuration
# ---------------------------------------------
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_PREMIUM=1000
RATE_LIMIT_BURST_MULTIPLIER=2
RATE_LIMIT_BURST_DURATION=10

# ---------------------------------------------
# RAG Pipeline Configuration
# ---------------------------------------------
RAG_TOP_K_CANDIDATES=20
RAG_TOP_N_FINAL=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CONTEXT_WINDOW_LIMIT=8000
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128

# ---------------------------------------------
# Error Tracking (Sentry)
# ---------------------------------------------
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------
# Session & Analytics
# ---------------------------------------------
SESSION_RETENTION_DAYS=90
ANALYTICS_ENABLED=true
FEEDBACK_ENABLED=true

# ---------------------------------------------
# Feature Flags
# ---------------------------------------------
FEATURE_GENERAL_KNOWLEDGE_MODE=false
FEATURE_TONE_CUSTOMIZATION=true
FEATURE_KEY_TERM_HIGHLIGHTING=true
FEATURE_GROUNDING_VALIDATION=true

# ---------------------------------------------
# Development Only
# ---------------------------------------------
DEV_MOCK_VECTOR_DB=false
DEV_MOCK_LLM=false
DEV_SKIP_AUTH=true
